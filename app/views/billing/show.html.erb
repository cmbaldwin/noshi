<div class="container mx-auto max-w-2xl">
  <h1 class="text-xl lg:text-2xl font-semibold mt-4 mb-2"><%= t('billing.title') %></h1>

  <% if params[:status] == "success" %>
    <p class="text-green-700 rounded bg-green-50 border border-green-200 p-3 mb-4"><%= t('billing.success') %></p>
  <% elsif params[:status] == "cancel" %>
    <p class="text-orange-700 rounded bg-orange-50 border border-orange-200 p-3 mb-4"><%= t('billing.canceled') %></p>
  <% end %>

  <div class="border border-slate-200 rounded p-4 mb-4">
    <h2 class="font-medium text-lg mb-1"><%= t('billing.plan_free') %></h2>
    <p class="text-sm text-slate-600"><%= t('billing.plan_free_desc') %></p>
  </div>

  <div class="border-2 rounded p-4 <%= current_user.image_storage? ? 'border-green-300' : 'border-sky-300' %>">
    <h2 class="font-medium text-lg mb-1"><%= t('billing.plan_paid') %></h2>
    <p class="text-sm text-slate-600 mb-3"><%= t('billing.plan_paid_desc') %></p>

    <% if current_user.image_storage? %>
      <p class="text-green-700 text-sm font-medium mb-3"><%= t('billing.current_plan') %></p>
      <%= button_to t('billing.manage'), billing_portal_path, method: :post,
            class: "border rounded px-4 py-2 bg-white hover:bg-slate-100" %>
    <% elsif @configured %>
      <div class="flex flex-wrap gap-2">
        <% @plans.each do |plan| %>
          <%= button_to t("billing.upgrade_#{plan}"), billing_checkout_path,
                method: :post, params: { plan: plan }, data: { turbo: false },
                class: "border rounded px-4 py-2 bg-sky-300 hover:bg-sky-400 font-medium" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-slate-500 text-sm"><%= t('billing.unavailable') %></p>
    <% end %>
  </div>

  <p class="mt-4">
    <%= link_to t('saved_noshi.my_noshi'), saved_noshis_path, class: "text-sky-600 underline text-sm" %>
  </p>
</div>
