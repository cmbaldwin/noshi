<div class="flex items-center gap-2 ml-2 mt-2 lg:mt-0">
  <% if user_signed_in? %>
    <% if current_user.avatar_url.present? %>
      <%= image_tag current_user.avatar_url, alt: current_user.display_name,
            class: "w-7 h-7 rounded-full border border-white", referrerpolicy: "no-referrer" %>
    <% end %>
    <span class="text-white text-sm hidden lg:inline"><%= current_user.display_name %></span>
    <%= button_to t("auth.sign_out"), logout_path, method: :delete,
          class: "text-sm leading-none border rounded text-white border-white hover:border-transparent hover:text-teal-500 hover:bg-white bg-sky-300 px-2 py-1" %>
  <% else %>
    <%# Full-page submit (data-turbo false): Turbo can't follow the cross-origin
        redirect to Google. The POST carries the CSRF token omniauth requires. %>
    <%= button_to t("auth.sign_in_google"), "/auth/google_oauth2", method: :post,
          data: { turbo: false },
          class: "flex items-center gap-1 text-sm leading-none border rounded text-white border-white hover:border-transparent hover:text-teal-500 hover:bg-white bg-sky-300 px-2 py-1" %>
  <% end %>
</div>
