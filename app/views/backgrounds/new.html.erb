<div class="container mx-auto max-w-lg">
  <h1 class="text-xl lg:text-2xl font-semibold mt-4 mb-3"><%= t('background.upload_title') %></h1>
  <p class="text-sm text-slate-600 mb-4"><%= t('background.upload_help') %></p>

  <%= form_with model: @background, url: backgrounds_path, method: :post do |f| %>
    <% if @background.errors.any? %>
      <div class="rounded bg-orange-50 border border-orange-200 text-orange-700 p-3 mb-3 text-sm">
        <% @background.errors.full_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <label class="block text-sm font-medium mb-1"><%= t('background.field_title') %></label>
    <%= f.text_field :title, class: "w-full rounded border border-slate-300 p-2 mb-3" %>

    <label class="block text-sm font-medium mb-1"><%= t('background.field_description') %></label>
    <%= f.text_area :description, rows: 2, class: "w-full rounded border border-slate-300 p-2 mb-3" %>

    <label class="block text-sm font-medium mb-1"><%= t('background.field_orientation') %></label>
    <%= f.select :orientation,
          Background::ORIENTATIONS.map { |o| [t("background.orientation_#{o}"), o] },
          {}, class: "w-full rounded border border-slate-300 p-2 mb-3" %>

    <label class="block text-sm font-medium mb-1"><%= t('background.field_image') %></label>
    <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp",
          class: "w-full rounded border border-slate-300 p-2 mb-4" %>

    <div class="flex gap-2">
      <%= f.submit t('background.submit'),
            class: "rounded border px-4 py-2 bg-lime-300 hover:bg-lime-400 font-medium cursor-pointer" %>
      <%= link_to t('background.my_uploads'), mine_backgrounds_path,
            class: "rounded border px-4 py-2 bg-white hover:bg-slate-100" %>
    </div>
  <% end %>
</div>
