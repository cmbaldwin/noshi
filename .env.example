# Copy to .env for local development (.env is gitignored). In production these
# are provided via .kamal/secrets and listed under env.secret in config/deploy.yml.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI (dev):  http://localhost:3000/auth/google_oauth2/callback
# Authorized redirect URI (prod): https://noshi.moab.jp/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Billing degrades gracefully
# (shows "unavailable") when these are blank, so they're optional locally.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Recurring prices for the paid image-storage plan (price_...). At least one is
# required for billing to be available; the billing page shows a button per plan.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# From the Stripe CLI / dashboard webhook endpoint (whsec_...). When blank, the
# webhook accepts unverified payloads (dev convenience only — set it in prod).
STRIPE_WEBHOOK_SECRET=
